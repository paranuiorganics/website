# Copy to .env for local dev. In CI these come from GitHub repo variables (Settings > Secrets and variables > Actions > Variables).
# test (default) or production
DEPLOY_ENV=test
# Web3Forms access key (public by design). Leave empty to show the form without sending.
PUBLIC_WEB3FORMS_KEY=
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics and the consent banner.
PUBLIC_GA_ID=
