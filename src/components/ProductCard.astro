---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
interface Props { product: CollectionEntry<'products'> }
const { product } = Astro.props;
const { title, summary, image, imageAlt, tags } = product.data;
const { Content } = await render(product);
const hasDetails = Boolean(product.body?.trim());
---
<article class="card flex flex-col" id={product.id}>
  <Image src={image} alt={imageAlt} widths={[400, 640, 900]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
  <div class="flex flex-1 flex-col px-5 pb-5 pt-4">
    <h2 class="!text-xl">{title}</h2>
    <p class="mt-1 text-[15px] text-muted">{summary}</p>
    {tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Good for">
        {tags.map((t) => <li class="rounded-full bg-sage-light px-2.5 py-0.5 text-xs font-bold text-sage-dark">{t}</li>)}
      </ul>
    )}
    {hasDetails && (
      <details class="mt-3 text-[15px]">
        <summary class="cursor-pointer font-extrabold text-sage-dark">More details</summary>
        <div class="mt-2 text-muted"><Content /></div>
      </details>
    )}
  </div>
</article>
