---
// Monster Mulching partnership box. Dark panel because their logo is designed for a dark background.
import { Image } from 'astro:assets';
import mmLogo from '../assets/images/monster-mulching-logo.png';
interface Props { class?: string }
const { class: cls = 'mt-6' } = Astro.props;
---
<aside class:list={[cls, 'flex flex-col gap-5 rounded-card bg-[#0a0e09] p-6 text-[#d9e0d2] sm:p-8 lg:flex-row lg:items-center lg:justify-between']} aria-labelledby="partner-mm">
  <a href="https://monstermulching.nz" target="_blank" rel="noopener" class="shrink-0 self-center">
    <Image src={mmLogo} alt="Monster Mulching" width={240} densities={[1, 2]} class="h-auto w-52 sm:w-60" />
  </a>
  <div class="max-w-[62ch]">
    <p class="eyebrow !text-[#7fe04a]">In partnership</p>
    <h3 id="partner-mm" class="mt-1 !text-white">Commercial wood grinding with Monster Mulching</h3>
    <p class="mt-2">When the job calls for serious muscle, we work hand in hand with our friends at Monster Mulching. Their heavy-duty grinders turn bulky timber, branches and wood waste into rich, useful mulch, so good wood never ends up wasted. From the paddock to the garden bed, it's all part of the same natural cycle.</p>
  </div>
  <div class="flex shrink-0 flex-col gap-2 sm:flex-row lg:flex-col">
    <a href="tel:+64274573482" class="btn justify-center bg-[#7fe04a] text-[#0a0e09] hover:bg-white">Call 027 457 3482</a>
    <a href="https://monstermulching.nz" target="_blank" rel="noopener" class="btn btn-ghost justify-center text-white">monstermulching.nz</a>
  </div>
</aside>
