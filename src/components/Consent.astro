---
// GA4 with Google Consent Mode v2. gtag.js only loads after the visitor accepts.
// Choice is stored in localStorage ('po-consent' = 'granted' | 'denied').
interface Props { gaId: string }
const { gaId } = Astro.props;
---
<div id="consent" hidden class="fixed inset-x-3 bottom-3 z-[1500] mx-auto max-w-xl rounded-2xl border border-line bg-paper p-4 shadow-xl sm:p-5" role="dialog" aria-live="polite" aria-label="Cookie consent">
  <p class="text-[15px]">We use Google Analytics cookies to understand how visitors use this site. No advertising, and nothing is set unless you accept.</p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" data-consent="granted" class="btn btn-primary px-5 py-2">Accept</button>
    <button type="button" data-consent="denied" class="btn btn-outline px-5 py-2">Decline</button>
  </div>
</div>
<script is:inline define:vars={{ gaId }}>
  (function () {
    var KEY = 'po-consent';
    var box = document.getElementById('consent');
    function load() {
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'granted' });
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
      document.head.appendChild(s);
    }
    var choice = null;
    try { choice = localStorage.getItem(KEY); } catch (e) {}
    if (choice === 'granted') load();
    else if (choice !== 'denied') box.hidden = false;
    box.addEventListener('click', function (e) {
      var v = e.target.closest('[data-consent]');
      if (!v) return;
      v = v.getAttribute('data-consent');
      try { localStorage.setItem(KEY, v); } catch (e) {}
      box.hidden = true;
      if (v === 'granted') load();
    });
  })();
</script>
