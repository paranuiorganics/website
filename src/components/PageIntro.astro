---
interface Props { eyebrow?: string; title: string; class?: string }
const { eyebrow, title, class: cls } = Astro.props;
---
<div class:list={['max-w-2xl', cls]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-1 !text-4xl sm:!text-5xl">{title}</h1>
  <div class="mt-3 text-lg text-muted"><slot /></div>
</div>
