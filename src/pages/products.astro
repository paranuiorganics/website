---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProductCard from '../components/ProductCard.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Products | Paranui Organics"
  description="Organic compost, vegetable mix, garden mix, lawn mix, bark mulch and shavings, made in Foxton by Paranui Organics and sold through garden centres across the lower North Island."
>
  <section class="section">
    <div class="wrap">
      <PageIntro eyebrow="Made in Foxton" title="Products">
        <p>All our products come from well-known sources that are clear of pesticides and herbicides.</p>
      </PageIntro>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => <ProductCard product={p} />)}
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded-card bg-sage-dark px-7 py-6 text-white">
        <p class="text-lg font-semibold">To order, visit your nearest supplier. For larger bulk orders, contact us directly.</p>
        <div class="flex flex-wrap gap-3">
          <a href="/suppliers" class="btn bg-paper text-soil hover:bg-cream-2">Find a supplier</a>
          <a href="/contact" class="btn btn-ghost">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
