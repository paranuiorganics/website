---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import seedlings from '../assets/images/seedlings.jpg';
import business from '../data/business.json';
---
<Base
  title="Contact | Paranui Organics"
  description="Contact Paranui Organics about garden products, bulk orders or commercial organic waste recycling. Phone 06 329 9707."
>
  <section class="section">
    <div class="wrap grid items-stretch gap-10 lg:grid-cols-2">
      <div>
        <PageIntro eyebrow="Get in touch" title="Contact us">
          <p>Interested in helping to make the world a greener place? Get in touch to learn more about our wide range of products and recycling services.</p>
        </PageIntro>
        <p class="mt-6">For all enquiries, call<br /><a href={`tel:${business.phoneE164}`} class="text-3xl font-extrabold text-soil no-underline hover:underline">{business.phone}</a></p>
        <p class="mt-6">Or send us a message:</p>
        <EnquiryForm />
      </div>
      <Image src={seedlings} alt="Seedlings growing in pots of compost" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 560px, 100vw" class="hidden size-full min-h-80 rounded-card object-cover lg:block" />
    </div>
  </section>
</Base>
