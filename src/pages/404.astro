---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base title="Page not found | Paranui Organics" description="This page doesn't exist.">
  <section class="section">
    <div class="wrap">
      <PageIntro eyebrow="404" title="Page not found">
        <p>That page doesn't exist or has moved.</p>
      </PageIntro>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href="/suppliers" class="btn btn-outline">Find a supplier</a>
      </div>
    </div>
  </section>
</Base>
