---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import MonsterMulching from '../components/MonsterMulching.astro';
import truck from '../assets/images/truck.jpg';
---
<Base
  title="Commercial Organic Waste Recycling | Paranui Organics"
  description="Paranui Organics recycles commercial organic waste into compost in Foxton, Manawatū. Talk to us about your waste stream."
  ogImage={truck}
>
  <section class="section">
    <div class="wrap grid items-center gap-10 lg:grid-cols-2">
      <div>
        <PageIntro eyebrow="Commercial recycling" title="Commercial organic waste recycling">
          <p class="font-bold text-soil">Turn your organic waste into compost, not landfill.</p>
        </PageIntro>
        <p class="mt-4 text-muted">Since 2006, Paranui Organics has recycled commercial organic waste at our Foxton yard. What comes in is composted and turned for 9 to 12 months, then goes back into gardens across the lower North Island as our organic compost and garden mixes.</p>
        <p class="mt-4 text-muted">We take most commercial organic waste streams. Every job is different, so the best first step is a quick chat about what you have.</p>
        <p class="mt-6 text-lg font-semibold">For all enquiries, call Glenn on<br /><a href="tel:+64275129436" class="text-3xl font-extrabold text-soil no-underline hover:underline">027 512 9436</a></p>
      </div>
      <Image src={truck} alt="Paranui Organics compost truck" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 560px, 100vw" class="aspect-[4/3] w-full rounded-card object-cover" loading="eager" />
    </div>
  </section>

  <section class="pb-14 sm:pb-20">
    <div class="wrap">
      <MonsterMulching class="" />
    </div>
  </section>

  <section class="section bg-cream-2">
    <div class="wrap max-w-3xl">
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-1">Talk to us about your waste</h2>
      <p class="mt-3 text-muted">Call <a href="tel:+64275129436" class="link whitespace-nowrap">Glenn on 027 512 9436</a>, or leave your details and we'll get back to you.</p>
      <EnquiryForm subject="Commercial recycling enquiry from paranuiorganics.co.nz" business subjectField={false} />
    </div>
  </section>
</Base>
